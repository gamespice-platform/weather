# Sibling repositories. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
#   ln -s ../../gs-fx/addons/gs_fx addons/gs_fx                   (optional: drawing precipitation)
#   ln -s ../../gs-lighting/addons/gs_lighting addons/gs_lighting (optional: fog)
# Consumers copy the addons they want into their own project.
/addons/gs_core
/addons/gs_fx
/addons/gs_lighting

